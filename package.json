{
  "name": "form-to-excel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "test:backup": "node --test test/backup.test.mjs",
    "test:features": "node --test test/features.test.mjs",
    "test:merged-files-share": "node --test test/merged-files-share.test.mjs",
    "test:pwa": "node --test test/pwa-worker.test.mjs",
    "test": "npm run test:backup && npm run test:features && npm run test:merged-files-share && npm run test:pwa"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "dexie": "^4.2.0",
    "fflate": "0.8.3",
    "i18next": "^25.5.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.7.0",
    "react-router-dom": "^7.9.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  }
